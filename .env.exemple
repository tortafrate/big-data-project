# --- VERSIONS DES IMAGES ---
AIRFLOW_VERSION=3.1.5
SPARK_VERSION=4.1.1
ELASTIC_VERSION=9.2.3
POSTGRES_VERSION=17.7

# --- IDENTIFIANTS (SECRETS) ---
# Postgres (Metastore Airflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow Admin User
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow

AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD= mettre commande docker compose logs airflow-webserver avec : Simple auth manager | Password for user 'admin': xxxxxxxxxxxx

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- PORTS EXPOSÉS (HOST) ---
AIRFLOW_WEB_PORT=8080
SPARK_WEB_PORT=9090
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KIBANA_PORT=5601
ELASTIC_PORT=9200
